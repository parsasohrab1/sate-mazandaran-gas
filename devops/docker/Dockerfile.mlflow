# MLflow tracking server + model registry.
# Backend store: postgresql (prod) or file (dev). Artifact store: S3-compatible or local.

FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /mlflow

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir mlflow==2.10.* \
    psycopg2-binary==2.9.* boto3==1.34.*

RUN useradd -r -u 10002 -g root mlflow && \
    mkdir -p /mlflow /mlruns /mlartifacts && \
    chown -R mlflow:root /mlflow /mlruns /mlartifacts

USER 10002
EXPOSE 5000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:5000/health || exit 1

# Default: file backend for dev. Override MLFLOW_BACKEND_STORE_URI and
# MLFLOW_DEFAULT_ARTIFACT_ROOT in compose/k8s for production.
ENV MLFLOW_BACKEND_STORE_URI=file:///mlruns \
    MLFLOW_DEFAULT_ARTIFACT_ROOT=file:///mlartifacts

CMD ["sh", "-c", "mlflow server \
    --backend-store-uri ${MLFLOW_BACKEND_STORE_URI} \
    --default-artifact-root ${MLFLOW_DEFAULT_ARTIFACT_ROOT} \
    --host 0.0.0.0 --port 5000"]
