# ===== Application =====
APP_NAME=sate-mazandaran-gas
APP_ENV=dev
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== Data =====
DATA_ROOT=./data
DATA_RAW=${DATA_ROOT}/raw
DATA_PROCESSED=${DATA_ROOT}/processed
DATA_SYNTHETIC=${DATA_ROOT}/synthetic
DATA_DOWNLOAD_TOKEN=  # set only if a catalogued source requires auth

# ===== Model =====
MODEL_REGISTRY=./models
MODEL_DEFAULT=ensemble
MODEL_INPUT_SIZE=224
MODEL_NUM_CLASSES=6

# ===== MLflow =====
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT=weld-defect-detection
MLFLOW_MODEL_NAME=weld-defect-ensemble

# ===== API =====
API_MAX_UPLOAD_MB=10
API_CONF_THRESHOLD=0.5

# ===== Security =====
API_KEY=  # generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=

# ===== DVC / remote (optional) =====
DVC_REMOTE_PATH=
